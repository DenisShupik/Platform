{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Swagger": {
      "IsCommonDocument": true,
      "CommonDocumentName": "gateway"
    },
    "Routes": {
      "notificationServiceUserSubscriptions": {
        "ClusterId": "notificationServiceCluster",
        "Match": {
          "Path": "/api/users/{userId}/subscriptions/{**catch-all}"
        },
        "Order": 0
      },
      "coreServiceUserBookmarks": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/users/{userId}/bookmarks/{**catch-all}"
        },
        "Order": 0
      },
      "coreServiceSearch": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        }
      },
      "coreServiceForums": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/forums/{**catch-all}"
        }
      },
      "coreServiceCategories": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "coreServiceThreads": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/threads/{**catch-all}"
        }
      },
      "coreServicePosts": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "userService": {
        "ClusterId": "userServiceCluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Order": 1
      },
      "fileService": {
        "ClusterId": "fileServiceCluster",
        "Match": {
          "Path": "/api/avatars/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "coreServiceCluster": {
        "Destinations": {
          "coreServiceDestination": {
            "Address": "http://core-service:8010",
            "Swaggers": [
              {
                "Paths": [
                  "/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "userServiceCluster": {
        "Destinations": {
          "userServiceDestination": {
            "Address": "http://user-service:8020",
            "Swaggers": [
              {
                "Paths": [
                  "/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "fileServiceCluster": {
        "Destinations": {
          "fileServiceDestination": {
            "Address": "http://file-service:8030",
            "Swaggers": [
              {
                "Paths": [
                  "/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "notificationServiceCluster": {
        "Destinations": {
          "notificationServiceDestination": {
            "Address": "http://notification-service:8040",
            "Swaggers": [
              {
                "Paths": [
                  "/api/openapi.json"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Protocols": "Http1AndHttp2",
        "Url": "http://+:8000"
      }
    }
  }
}
