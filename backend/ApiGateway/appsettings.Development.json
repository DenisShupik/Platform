{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "notificationServiceNotifications": {
        "ClusterId": "notificationServiceCluster",
        "Match": {
          "Path": "/api/me/notifications/{**catch-all}"
        }
      },
      "notificationServiceUserSubscriptions": {
        "ClusterId": "notificationServiceCluster",
        "Match": {
          "Path": "/api/users/{userId}/subscriptions/{**catch-all}"
        },
        "Order": 0
      },
      "coreServiceSearch": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        }
      },
      "coreServiceUserBookmarks": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/users/{userId}/bookmarks/{**catch-all}"
        },
        "Order": 0
      },
      "coreServiceForums": {
        "ClusterId": "coreServiceCluster",
        "Match": {
          "Path": "/api/{forums,categories,threads,posts}/{**catch-all}"
        },
        "Order": 2
      },
      "userService": {
        "ClusterId": "userServiceCluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Order": 1
      },
      "fileService": {
        "ClusterId": "fileServiceCluster",
        "Match": {
          "Path": "/api/avatars/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "coreServiceCluster": {
        "Destinations": {
          "coreServiceDestination": {
            "Address": "http://localhost:8010",
            "Swaggers": [
              {
                "Paths": [
                  "/api/openapi.json"
                ]
              }
            ]
          }
        }
      },
      "userServiceCluster": {
        "Destinations": {
          "userServiceDestination": {
            "Address": "http://localhost:8020",
            "Swaggers": [
              {
                "Paths": [
                  "/api/openapi.json"
                ]
              }
            ]
          }
        }
      },
      "fileServiceCluster": {
        "Destinations": {
          "fileServiceDestination": {
            "Address": "http://localhost:8030",
            "Swaggers": [
              {
                "Paths": [
                  "/api/openapi.json"
                ]
              }
            ]
          }
        }
      },
      "notificationServiceCluster": {
        "Destinations": {
          "notificationServiceDestination": {
            "Address": "http://localhost:8040",
            "Swaggers": [
              {
                "Paths": [
                  "/api/openapi.json"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Protocols": "Http1AndHttp2",
        "Url": "http://+:8000"
      }
    }
  }
}
